{
  "name": "finch",
  "version": "0.0.0",
  "private": true,
  "description": "FINCH — Financial Decision & Action OS. Root workspace.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25.0.0",
    "pnpm": ">=11.26.0 <12.0.0"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "env:doctor": "node scripts/env-doctor.mjs",
    "dev": "turbo run dev --filter=@finch/api --filter=@finch/web",
    "dev:all": "turbo run dev",
    "dev:infra": "docker compose -f infra/docker/compose.yaml up -d",
    "dev:infra:down": "docker compose -f infra/docker/compose.yaml down",
    "build": "turbo run build",
    "lint": "turbo run build --output-logs=errors-only && eslint .",
    "lint:fix": "turbo run build --output-logs=errors-only && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "financial:verify": "turbo run financial:verify --filter=@finch/financial-engine",
    "ai:eval": "node scripts/ai-eval.mjs",
    "ai:sync": "node scripts/ai-sync.mjs",
    "ai:check": "node scripts/ai-sync.mjs --check",
    "architecture:check": "node scripts/architecture-check.mjs --self-test",
    "security:check": "node scripts/security-check.mjs --self-test",
    "db:migrate": "turbo run db:migrate --filter=@finch/db",
    "db:seed": "turbo run db:seed --filter=@finch/db",
    "openapi:generate": "turbo run openapi:generate --filter=@finch/api",
    "release:verify": "node scripts/release-verify.mjs",
    "check": "pnpm ai:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm architecture:check && pnpm security:check && pnpm test"
  },
  "devDependencies": {
    "@finch/eslint-config": "workspace:*",
    "@types/node": "24.10.1",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "syncpack": "15.3.3",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
