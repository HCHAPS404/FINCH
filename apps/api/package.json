{
  "name": "@finch/api",
  "version": "0.0.0",
  "private": true,
  "description": "Core HTTP API. NestJS + Fastify, REST under /api/v1, OpenAPI emitted in CI.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "openapi:generate": "nest build && node dist/generate-openapi.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@finch/authorization": "workspace:*",
    "@finch/config": "workspace:*",
    "@finch/contracts": "workspace:*",
    "@finch/db": "workspace:*",
    "@finch/domain": "workspace:*",
    "@finch/observability": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
