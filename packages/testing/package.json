{
  "name": "@finch/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test factories, synthetic personas and the Testcontainers harness. README §73, §80.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@finch/contracts": "workspace:*",
    "@finch/domain": "workspace:*",
    "@testcontainers/postgresql": "12.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
