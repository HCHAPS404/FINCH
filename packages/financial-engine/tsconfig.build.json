{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Build state lives inside dist/: deleting dist/ must force a rebuild, not a no-op.
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  // The only workspace dependency the engine may have (dependency-cruiser enforces it).
  "references": [{ "path": "../contracts/tsconfig.build.json" }]
}
