{
  "name": "@finch/financial-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure deterministic financial mathematics. No framework, no I/O, no infrastructure. README \u00a714.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "financial:verify": "vitest run --reporter=json --outputFile=../../artifacts/financial-correctness.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "@vitest/coverage-v8": "5.0.1"
  }
}
