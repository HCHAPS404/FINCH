{
  "name": "@finch/authorization",
  "version": "0.0.0",
  "private": true,
  "description": "Relational authorization: can(principal, action, resource, workspace, context). README \u00a79.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
