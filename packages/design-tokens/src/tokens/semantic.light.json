      "infoBg": { "$value": "{color.blue.50}" }
    },
    "truth": {
      "verifiedFg": { "$value": "{color.green.700}" },
      "verifiedBg": { "$value": "{color.greenTint.50}" },
      "declaredFg": { "$value": "{color.blue.700}" },
