  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" },
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.625rem" },
    "lg": { "$value": "1rem" },
    "xl": { "$value": "1.5rem" },
    "pill": { "$value": "999rem" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" },
      "fast": { "$value": "150ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "280ms" },
      "number": { "$value": "600ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] }
    }
  },
  "size": {
    "$type": "dimension",
    "touchTarget": { "$value": "2.75rem" },
    "focusRing": { "$value": "0.1875rem" },
    "contentMax": { "$value": "72rem" },
    "readingMax": { "$value": "42rem" }
