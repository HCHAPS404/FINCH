    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.25 },
      "normal": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
