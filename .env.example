# ---------------------------------------------------------------------------
# FINCH local environment template — README §61.
#
# Copy to `.env` (gitignored). NEVER put a real production secret in either file.
# Production secrets live in AWS Secrets Manager and are injected at runtime (§40).
#
# Every key here is validated at startup by @finch/config. An unknown or malformed
# value fails fast rather than producing undefined behaviour deep in a request.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
FINCH_ENV=local

# --- API -------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
# The one browser origin allowed to call the API cross-origin (CORS).
WEB_APP_ORIGIN=http://localhost:3000

# --- Database (local Docker — see infra/docker/compose.yaml) ---------------
# Local-only credentials. The compose file uses these same values.
DATABASE_URL=postgresql://finch:finch_local_dev@localhost:5432/finch_dev
DATABASE_POOL_MAX=10

# --- Jurisdiction (README §36) ---------------------------------------------
FINCH_DEFAULT_LOCALE=es-CO
FINCH_DEFAULT_TIMEZONE=America/Bogota
FINCH_DEFAULT_CURRENCY=COP

# --- Observability (README §46) --------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=finch-api
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- Identity (README §8, ADR-0015 still OPEN — port only, no vendor yet) ---
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# --- Interim local credentials (ADR-0041) -----------------------------------
# Signs PasswordAuthSessionAdapter's session tokens. Local-only value below;
# a real environment must set a real secret (min 32 chars), never this default.
AUTH_SESSION_SECRET=local-dev-only-secret-change-me-0041

# --- Document storage (ADR-0041 — local disk adapter, swappable per ADR-0022) -
DOCUMENTS_STORAGE_DIR=./.data/documents

# --- Feature flags / kill switches (README §62) ----------------------------
# Foundation ships these disabled. They exist so the kill path is real from day one.
FEATURE_BANK_SYNC_ENABLED=false
FEATURE_DOCUMENT_AI_ENABLED=false
FEATURE_EXTERNAL_ACTIONS_ENABLED=false
FEATURE_PAYMENT_EXECUTION_ENABLED=false
FEATURE_AI_EXPLANATIONS_ENABLED=false
