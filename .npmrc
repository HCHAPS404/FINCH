# FINCH pnpm configuration — see docs/architecture/adr/0034-node-runtime-and-toolchain-pinning.md

# Enforce the Node engine range declared in package.json (README §56: no `latest`).
engine-strict=true

# Supply-chain posture (README §43): dependency scripts are opt-in, not implicit.
# Packages needing build scripts must be listed in pnpm.onlyBuiltDependencies.
# (pnpm >=10 blocks lifecycle scripts by default; kept explicit here.)
auto-install-peers=true
strict-peer-dependencies=false
resolution-mode=highest

# Reproducibility
prefer-frozen-lockfile=true
save-exact=true
