# ---------------------------------------------------------------------------
# FINCH .gitignore
# Security-first: secrets, credentials and signing material must NEVER be
# committed. See SECURITY.md and README.md §12, §40, §122.
# ---------------------------------------------------------------------------

# --- Secrets & credentials (README §40 — deny by default) ------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest
secrets/
.secrets/
credentials
.aws/
.netrc
gha-creds-*.json
service-account*.json

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.npm/

# --- Build output ----------------------------------------------------------
dist/
build/
out/
.next/
# Regenerated by `next dev`/`next build`/`next typegen`, differently depending on
# which one ran last (its route-type imports follow the active distDir) — tracking it
# produces unwanted diffs on every build. Official Next.js 16 recommendation.
next-env.d.ts
.expo/
.expo-shared/
.turbo/
*.tsbuildinfo
.rollup.cache/
.swc/

# --- Rust / Tauri ----------------------------------------------------------
target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# --- Native mobile ---------------------------------------------------------
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.ipa
*.dSYM.zip

# --- Test & coverage artifacts --------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
*.lcov

# --- Generated evidence (regenerated by CI; see README §45) ----------------
artifacts/
reports/
*.sbom.json
sbom.spdx.json
checksums.txt

# --- Infrastructure state (NEVER commit tofu state — contains secrets) -----
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Local databases & dumps (may contain financial data) ------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
pgdata/

# --- Local document storage (ADR-0041 LocalDiskStorageAdapter — may contain PII) ---
.data/

# --- Editors & OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# --- Local agent scratch (not repository state) ----------------------------
.ai/tasks/local-*
.ai/handoffs/local-*
.claude/settings.local.json
